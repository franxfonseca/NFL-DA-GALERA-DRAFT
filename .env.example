# Copie esse arquivo pra ".env" (sem o .example) e cole sua chave de verdade.
# Pega a chave gratis em https://console.groq.com -> API Keys
GROQ_API_KEY=

# Narracao com voz melhor (Arnold). Precisa de creditos na conta -
# https://elevenlabs.io -> Settings -> API Keys. De permissao de
# Text to Speech na chave, no minimo. Sem essa chave, o app cai
# automaticamente pro speechSynthesis local do navegador.
ELEVENLABS_API_KEY=
